<Project>
  <!--
    Production build: one self-contained DdnsUpdate.exe (see docs/BUILDING.md).
    Usage, from the repository root:
      dotnet publish src\DdnsUpdate.Application -p:PublishProfile=win-x64-single
    Output goes to publish\ at the repository root.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- required: FilePathHelper and Program rely on AppDomain.CurrentDomain.BaseDirectory, which
         is the executable's directory in a single-file bundle -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
